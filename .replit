# Replit: press Run for the dev server; Deploy uses the production build served by `vite preview` (keeps /food/:id deep links and QR codes working).
run = "npm install && npm run dev -- --port 5000"
modules = ["nodejs-22"]

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm install && npm run build"]
run = ["sh", "-c", "PORT=5000 npm run start"]
